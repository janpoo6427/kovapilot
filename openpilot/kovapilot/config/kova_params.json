{
  "$schema": "./kova_params.schema.json",
  "schemaVersion": 1,
  "defaultLocale": "ko",
  "locales": ["ko", "en"],
  "groups": [
    {
      "id": "steering",
      "order": 100,
      "title": {"ko": "조향", "en": "Steering"},
      "description": {
        "ko": "차량의 횡방향 제어와 관련된 사용자 설정입니다.",
        "en": "User settings related to lateral vehicle control."
      }
    },
    {
      "id": "navigation",
      "order": 200,
      "title": {"ko": "내비게이션", "en": "Navigation"},
      "description": {"ko": "내비게이션 기반 주행 보조 설정입니다.", "en": "Navigation-based driving assistance settings."}
    },
    {
      "id": "display",
      "order": 200,
      "title": {"ko": "화면", "en": "Display"},
      "description": {
        "ko": "comma 장치 화면 표시와 관련된 사용자 설정입니다. 차량 제어에는 영향을 주지 않습니다.",
        "en": "User settings for the comma device screen. They do not affect vehicle control."
      }
    },
    {
      "id": "cruise",
      "order": 300,
      "title": {"ko": "크루즈", "en": "Cruise"},
      "description": {"ko": "크루즈 설정속도 관련 설정입니다.", "en": "Cruise set speed settings."}
    }
  ],
  "settings": [
    {
      "key": "steering.always_on",
      "dependencies": [
        {"condition": "independentLateralControl", "title": {"ko": "독립 횡제어 지원 및 연동", "en": "Independent lateral control support and integration"}}
      ],
      "groupId": "steering",
      "order": 100,
      "type": "enum",
      "control": "switch",
      "options": [0, 1],
      "optionTitles": {"0": {"ko": "끔", "en": "Off"}, "1": {"ko": "켬", "en": "On"}},
      "defaultValue": 0,
      "title": {"ko": "항시 조향", "en": "Always-on steering"},
      "description": {
        "ko": "지원되는 차량과 안전 조건에서 종방향 크루즈 상태와 독립적으로 조향 보조를 사용할 수 있도록 요청합니다. 실제 적용에는 별도의 차량 기능 소비자와 안전 검증이 필요합니다.",
        "en": "Requests steering assistance independently of longitudinal cruise state when vehicle support and safety conditions allow. Activation requires a separate vehicle-capability consumer and safety validation."
      },
      "access": "readWrite",
      "risk": "control",
      "applyPolicy": "offroad",
      "savePolicy": "anytime",
      "availability": "pendingConsumer",
      "requiredCapabilities": ["alwaysSteering"]
    },
    {
      "key": "navigation.speed_camera_profile",
      "dependencies": [
        {"condition": "openpilotLongitudinalApplied", "setting": "cruise.openpilot_longitudinal", "title": {"ko": "openpilot 종방향 제어", "en": "Openpilot longitudinal control"}},
        {"condition": "verifiedCameraInput", "title": {"ko": "검증된 내비 카메라 입력", "en": "Verified navigation camera input"}}
      ],
      "groupId": "navigation",
      "order": 100,
      "type": "enum",
      "options": [0, 1, 2, 3],
      "optionTitles": {
        "0": {"ko": "사용 안 함", "en": "Off"},
        "1": {"ko": "여유", "en": "Early"},
        "2": {"ko": "균형", "en": "Balanced"},
        "3": {"ko": "근접", "en": "Late"}
      },
      "defaultValue": 0,
      "title": {"ko": "카메라 감속 프로필", "en": "Speed camera profile"},
      "description": {
        "ko": "카메라 목표속도 도달 지점과 통과 후 복귀 성향을 설정합니다.",
        "en": "Selects where to reach the camera target speed and how quickly to resume after passing."
      },
      "access": "readWrite",
      "risk": "control",
      "applyPolicy": "offroad",
      "savePolicy": "anytime",
      "availability": "pendingConsumer"
    },
    {
      "key": "display.onroad_brightness_mode",
      "groupId": "display",
      "order": 100,
      "type": "enum",
      "defaultValue": 0,
      "options": [0, 1, 2],
      "optionTitles": {
        "0": {"ko": "자동", "en": "Auto"},
        "1": {"ko": "자동(어둡게)", "en": "Auto (dark)"},
        "2": {"ko": "고정", "en": "Fixed"}
      },
      "title": {"ko": "주행 중 화면 밝기", "en": "Onroad screen brightness"},
      "description": {
        "ko": "자동은 openpilot 기본 동작과 같습니다. 자동(어둡게)는 주변이 어두울수록 기본보다 더 어둡게(최저 10%) 합니다. 고정은 아래 고정 밝기를 씁니다. 경고가 떠 있는 동안에는 자동 밝기보다 어두워지지 않습니다.",
        "en": "Auto matches the openpilot default. Auto (dark) dims further in low light (down to 10%). Fixed uses the fixed brightness below. While an alert is shown the screen is never dimmer than Auto."
      },
      "access": "readWrite",
      "risk": "display",
      "applyPolicy": "immediate",
      "savePolicy": "anytime",
      "availability": "available"
    },
    {
      "key": "display.onroad_brightness_fixed",
      "dependencies": [
        {"setting": "display.onroad_brightness_mode", "equals": 2, "title": {"ko": "화면 밝기 모드 · 고정", "en": "Screen brightness mode · Fixed"}}
      ],
      "groupId": "display",
      "order": 110,
      "type": "integer",
      "defaultValue": 50,
      "minimum": 10,
      "maximum": 100,
      "step": 5,
      "unit": {"ko": "%", "en": "%"},
      "title": {"ko": "고정 밝기", "en": "Fixed brightness"},
      "description": {
        "ko": "주행 중 화면 밝기가 고정일 때 쓰는 밝기입니다. 30% 아래는 백라이트 대신 화면을 어둡게 덮어 표현합니다.",
        "en": "Brightness used when onroad screen brightness is Fixed. Values below 30% are produced by dimming the UI instead of the backlight."
      },
      "access": "readWrite",
      "risk": "display",
      "applyPolicy": "immediate",
      "savePolicy": "anytime",
      "availability": "available"
    },
    {
      "key": "cruise.accelerator_sync",
      "dependencies": [
        {"condition": "openpilotLongitudinalApplied", "setting": "cruise.openpilot_longitudinal", "title": {"ko": "openpilot 종방향 제어", "en": "Openpilot longitudinal control"}},
        {"condition": "openpilotCruiseSpeedOwner", "title": {"ko": "KOVA 크루즈 설정속도 제어", "en": "KOVA cruise set speed control"}},
        {"condition": "acceleratorDisengagementOff", "title": {"ko": "가속페달을 밟을 때 주행 보조 해제 · 끔", "en": "Disengage on accelerator pedal · Off"}}
      ],
      "groupId": "cruise",
      "order": 100,
      "type": "enum",
      "control": "switch",
      "options": [0, 1],
      "optionTitles": {"0": {"ko": "끔", "en": "Off"}, "1": {"ko": "켬", "en": "On"}},
      "defaultValue": 0,
      "title": {"ko": "크루즈 악셀 동기화", "en": "Cruise speed sync on accelerator release"},
      "description": {
        "ko": "openpilot이 크루즈 설정속도를 관리할 때, 설정속도를 넘어 가속한 뒤 페달을 놓으면 현재 속도로 설정속도를 올립니다. 가속 페달로 크루즈 해제 설정은 꺼져 있어야 합니다.",
        "en": "When openpilot manages the cruise set speed, raise it to your current speed if you accelerate above it and release the pedal. Requires Disengage on Accelerator Pedal to be off."
      },
      "access": "readWrite",
      "risk": "control",
      "applyPolicy": "restart",
      "savePolicy": "anytime",
      "availability": "available"
    },
    {
      "key": "cruise.curve_slowdown",
      "dependencies": [
        {"condition": "openpilotLongitudinalApplied", "setting": "cruise.openpilot_longitudinal", "title": {"ko": "openpilot 종방향 제어", "en": "Openpilot longitudinal control"}}
      ],
      "groupId": "cruise",
      "order": 150,
      "type": "enum",
      "control": "switch",
      "options": [0, 1],
      "optionTitles": {"0": {"ko": "끔", "en": "Off"}, "1": {"ko": "켬", "en": "On"}},
      "defaultValue": 0,
      "title": {"ko": "커브 감속", "en": "Curve slowdown"},
      "description": {
        "ko": "오픈파일럿이 속도를 제어할 때 커브 앞에서 감속하고, 커브를 벗어나면 크루즈 설정속도 쪽으로 돌아옵니다. 설정은 P에 두고 완전히 정차하면 반영돼요.",
        "en": "When openpilot controls speed, it slows before a curve and returns toward your cruise set speed after it. Changes apply while stopped in Park."
      },
      "access": "readWrite",
      "risk": "control",
      "applyPolicy": "parked",
      "savePolicy": "anytime",
      "availability": "pendingConsumer"
    },
    {
      "key": "cruise.accelerator_sync_stock_shadow",
      "dependencies": [
        {"condition": "stockCruiseSpeedOwner", "title": {"ko": "순정 ACC 설정속도 제어", "en": "Stock ACC cruise set speed control"}},
        {"condition": "acceleratorDisengagementOff", "title": {"ko": "가속페달을 밟을 때 주행 보조 해제 · 끔", "en": "Disengage on accelerator pedal · Off"}}
      ],
      "groupId": "cruise",
      "order": 200,
      "type": "enum",
      "control": "switch",
      "options": [0, 1],
      "optionTitles": {"0": {"ko": "끔", "en": "Off"}, "1": {"ko": "켬", "en": "On"}},
      "defaultValue": 0,
      "title": {"ko": "순정 ACC 동기화 진단", "en": "Stock ACC sync diagnostics"},
      "description": {
        "ko": "순정 ACC에서 페달을 놓을 때 동기화 후보와 차량의 설정속도를 기록합니다.",
        "en": "Log the candidate sync speed and the vehicle's set speed on accelerator release in stock ACC."
      },
      "access": "readWrite",
      "risk": "behavior",
      "applyPolicy": "immediate",
      "savePolicy": "anytime",
      "availability": "available"
    }
  ]
}

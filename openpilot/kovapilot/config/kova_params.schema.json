{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kova.local/schemas/kova_params.schema.json",
  "title": "KOVA parameter catalog",
  "type": "object",
  "required": ["schemaVersion", "defaultLocale", "locales", "groups", "settings"],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1},
    "defaultLocale": {"type": "string", "minLength": 2},
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "settings": {"type": "array", "items": {"$ref": "#/$defs/setting"}}
  },
  "additionalProperties": true,
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "group": {
      "type": "object",
      "required": ["id", "title", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "order": {"type": "integer"},
        "title": {"$ref": "#/$defs/localizedText"},
        "description": {"$ref": "#/$defs/localizedText"}
      },
      "additionalProperties": true
    },
    "setting": {
      "type": "object",
      "required": ["key", "groupId", "type", "defaultValue", "title", "description", "access", "risk", "applyPolicy", "availability"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "groupId": {"type": "string"},
        "order": {"type": "integer"},
        "type": {"enum": ["integer", "number", "enum"]},
        "defaultValue": {"type": "number"},
        "control": {"enum": ["switch"], "description": "Optional widget hint for an enum with integer values 0 and 1"},
        "title": {"$ref": "#/$defs/localizedText"},
        "description": {"$ref": "#/$defs/localizedText"},
        "access": {"enum": ["readOnly", "readWrite"]},
        "risk": {"enum": ["display", "behavior", "control"]},
        "applyPolicy": {"enum": ["immediate", "offroad", "parked", "restart"]},
        "savePolicy": {"enum": ["legacy", "anytime"]},
        "availability": {"enum": ["available", "pendingConsumer", "unsupported"]},
        "requiredCapabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "minimum": {"type": "number", "description": "integer/number only: inclusive lower bound"},
        "maximum": {"type": "number", "description": "integer/number only: inclusive upper bound"},
        "step": {"type": "number", "exclusiveMinimum": 0, "description": "integer/number only: UI step"},
        "unit": {"$ref": "#/$defs/localizedText", "description": "integer/number only: localized unit label"},
        "options": {"type": "array", "minItems": 1, "items": {"type": "integer"}, "description": "enum only: allowed integer values"},
        "optionTitles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/localizedText"}, "description": "enum only: localized title for every option, keyed by the option value as text"}
      },
      "additionalProperties": true
    }
  }
}
